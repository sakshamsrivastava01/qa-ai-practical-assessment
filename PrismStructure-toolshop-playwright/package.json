{
  "name": "prismstructure-toolshop-playwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ui": "playwright test --project=ui-chromium",
    "test:ui:smoke": "playwright test --project=ui-chromium --grep @smoke",
    "test:ui:regression": "playwright test --project=ui-chromium --grep @regression",
    "test:api": "playwright test --project=api",
    "test:api:smoke": "playwright test --project=api --grep @smoke",
    "test:api:regression": "playwright test --project=api --grep @regression",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "report": "playwright show-report execution-evidence/html-report",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "keywords": ["playwright", "qa-automation", "toolshop"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "dotenv": "^17.4.2"
  }
}
